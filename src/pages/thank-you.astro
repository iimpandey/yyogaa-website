---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Thank You — Yyogaa"
  showExplore={false}
>

<main>

  <section class="final-cta" style="min-height: 75vh;">

    <div>

      <p class="section-kicker">THANK YOU</p>

      <h2>
        Your message
        has been sent.
      </h2>

      <p>
        Thanks for reaching out to Yyogaa.
        We’ll be in touch soon.
      </p>

      <a href="/" class="button button-gold">
        Return Home
      </a>

    </div>

  </section>

</main>

</BaseLayout>
