---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Yyogaa — Move. Breathe. Return."
  description="Yyogaa is a modern space for yoga, breathwork, meditation, sound and mindful living."
>

<main>

  <!-- HERO -->

  <section class="hero">

    <div class="hero-left">

      <div class="hero-copy">

        <p class="eyebrow">
          MOVE · BREATHE · RETURN
        </p>

        <h1>
          Breathe
          <span>easy.</span>
        </h1>

        <p class="hero-description">
          Simple practices for movement, breath, meditation
          and sound — created to help you reconnect with yourself.
        </p>

        <div class="hero-actions">

          <a href="/yoga" class="button button-gold">
            Start practicing
          </a>

          <a href="/about" class="button button-outline">
            Explore Yyogaa
          </a>

        </div>

      </div>

    </div>


    <div class="hero-right">

      <img
        src="https://images.unsplash.com/photo-1545389336-cf090694435e?auto=format&fit=crop&w=1400&q=90"
        alt="Yoga practice"
      >

    </div>


    <div class="hero-bottom">

      <article class="hero-story">

        <img
          src="https://images.unsplash.com/photo-1575052814086-f385e2e2ad1b?auto=format&fit=crop&w=500&q=80"
          alt="Beginner yoga"
        >

        <div>
          <span>BEGINNER YOGA</span>
          <h3>Your first gentle morning flow</h3>
          <p>8 min practice</p>
        </div>

      </article>


      <article class="hero-story">

        <img
          src="https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&w=500&q=80"
          alt="Breathwork"
        >

        <div>
          <span>BREATH</span>
          <h3>A simple practice for calm</h3>
          <p>5 min practice</p>
        </div>

      </article>


      <article class="hero-story">

        <img
          src="https://images.unsplash.com/photo-1532798442725-41036acc7489?auto=format&fit=crop&w=500&q=80"
          alt="Meditation"
        >

        <div>
          <span>MEDITATION</span>
          <h3>Return to stillness</h3>
          <p>6 min practice</p>
        </div>

      </article>

    </div>

  </section>


  <!-- QUOTE -->

  <section class="quote">

    <div class="quote-symbol">“</div>

    <h2>
      The body opens through movement,
      <br>
      and the mind settles through breath.
    </h2>

    <p>YYOGAA</p>

  </section>


  <!-- JOURNAL -->

  <section class="journal section" id="journal">

    <div class="page-width">

      <div class="journal-header">

        <div>
          <p class="section-kicker">
            LATEST FROM THE JOURNAL
          </p>

          <h2>Practice. Learn. Grow.</h2>
        </div>

        <a href="/journal">
          View all articles →
        </a>

      </div>


      <div class="journal-layout">

        <div class="journal-grid">


          <article class="story-card">

            <img
              src="https://images.unsplash.com/photo-1599901860904-17e6ed7083a0?auto=format&fit=crop&w=1000&q=85"
              alt="Beginner yoga"
            >

            <p class="story-category">BEGINNER YOGA</p>

            <h3>
              Beginner Yoga:
              Where to Start
            </h3>

            <p class="story-copy">
              Everything you need to begin a simple,
              sustainable yoga practice.
            </p>

            <span>6 MIN READ</span>

          </article>


          <article class="story-card">

            <img
              src="https://images.unsplash.com/photo-1573590330099-d6c7355ec595?auto=format&fit=crop&w=1000&q=85"
              alt="Morning yoga"
            >

            <p class="story-category">MOVEMENT</p>

            <h3>
              A Morning Practice
              for More Energy
            </h3>

            <p class="story-copy">
              Gentle movement to wake up your body
              and prepare for the day.
            </p>

            <span>5 MIN READ</span>

          </article>


          <article class="story-card">

            <img
              src="https://images.unsplash.com/photo-1510894347712-4b17eeec7868?auto=format&fit=crop&w=1000&q=85"
              alt="Meditation"
            >

            <p class="story-category">MEDITATION</p>

            <h3>
              Learning to Sit
              With Stillness
            </h3>

            <p class="story-copy">
              Meditation doesn't have to be complicated.
              Begin with just a few minutes.
            </p>

            <span>4 MIN READ</span>

          </article>


          <article class="story-card">

            <img
              src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1000&q=85"
              alt="Breathwork"
            >

            <p class="story-category">BREATH</p>

            <h3>
              Breathwork for
              Stress and Sleep
            </h3>

            <p class="story-copy">
              Slow breathing practices that can help
              you settle before rest.
            </p>

            <span>5 MIN READ</span>

          </article>

        </div>


        <aside class="journal-sidebar">

          <div class="sidebar-section">

            <p class="section-kicker">MOST READ</p>

            <div class="most-read">

              <a href="/yoga">
                <span>1</span>
                <p>What Type of Yoga Is Right for You?</p>
              </a>

              <a href="/yoga">
                <span>2</span>
                <p>Yoga vs Stretching: What's the Difference?</p>
              </a>

              <a href="/yoga">
                <span>3</span>
                <p>How Often Should You Practice?</p>
              </a>

              <a href="/yoga">
                <span>4</span>
                <p>Yoga for Complete Beginners</p>
              </a>

              <a href="/breathwork">
                <span>5</span>
                <p>How Breath Changes Your Practice</p>
              </a>

            </div>

          </div>


          <div class="sidebar-section">

            <p class="section-kicker">
              EXPLORE YYOGAA
            </p>

            <div class="sidebar-links">

              <a href="/yoga">Yoga Basics</a>
              <a href="/yoga">Mobility & Flexibility</a>
              <a href="/yoga">Strength</a>
              <a href="/breathwork">Breathwork</a>
              <a href="/meditation">Meditation</a>
              <a href="/sound">Sound</a>
              <a href="/meditation">Sleep & Recovery</a>
              <a href="/journal">Yoga Philosophy</a>

            </div>

          </div>

        </aside>

      </div>

    </div>

  </section>


  <!-- FEATURED -->

  <section class="featured section">

    <div class="page-width">

      <div class="featured-box">

        <div class="featured-image">

          <img
            src="https://images.unsplash.com/photo-1545205597-3d9d02c29597?auto=format&fit=crop&w=1300&q=85"
            alt="Yoga practice"
          >

        </div>

        <div class="featured-copy">

          <p class="section-kicker">
            FEATURED PRACTICE
          </p>

          <h2>
            Your First
            20-Minute Yoga Practice
          </h2>

          <p>
            A gentle full-body session for anyone beginning
            their yoga journey.
          </p>

          <a href="/yoga" class="button button-gold-dark">
            Start the practice
          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- EDITOR PICKS -->

  <section class="editors section">

    <div class="page-width">

      <div class="center-heading">

        <p class="section-kicker">
          FROM THE JOURNAL
        </p>

        <h2>Editor's Picks</h2>

        <p>
          Practices and ideas worth returning to.
        </p>

      </div>


      <div class="editor-grid">

        <article class="editor-card">

          <img
            src="https://images.unsplash.com/photo-1600618528240-fb9fc964b853?auto=format&fit=crop&w=800&q=85"
            alt="Rest"
          >

          <p class="story-category">REST</p>

          <h3>Yoga for Better Sleep</h3>

          <p>
            Gentle practices to help the body slow down.
          </p>

        </article>


        <article class="editor-card">

          <img
            src="https://images.unsplash.com/photo-1588286840104-8957b019727f?auto=format&fit=crop&w=800&q=85"
            alt="Breathwork"
          >

          <p class="story-category">BREATH</p>

          <h3>Breathwork for Stress</h3>

          <p>
            Simple techniques for creating more calm.
          </p>

        </article>


        <article class="editor-card">

          <img
            src="https://images.unsplash.com/photo-1599447421416-3414500d18a5?auto=format&fit=crop&w=800&q=85"
            alt="Mobility"
          >

          <p class="story-category">MOVEMENT</p>

          <h3>Yoga for Mobility</h3>

          <p>
            Build freedom and awareness through movement.
          </p>

        </article>


        <article class="editor-card">

          <img
            src="https://images.unsplash.com/photo-1593811167562-9cef47bfc4d7?auto=format&fit=crop&w=800&q=85"
            alt="Meditation"
          >

          <p class="story-category">MEDITATION</p>

          <h3>The Practice of Presence</h3>

          <p>
            Come back to where you already are.
          </p>

        </article>

      </div>

    </div>

  </section>


  <!-- FOUNDATION -->

  <section class="foundation section" id="practice">

    <div class="page-width">

      <p class="section-kicker">
        READ ONCE · RETURN OFTEN
      </p>

      <h2>The Yyogaa Foundation</h2>

      <p class="foundation-intro">
        Build your practice from the ground up.
        Movement, breath, stillness and sound.
      </p>


      <div class="foundation-grid">


        <article class="foundation-card">

          <a href="/yoga">

            <img
              src="https://images.unsplash.com/photo-1575052814086-f385e2e2ad1b?auto=format&fit=crop&w=1000&q=85"
              alt="Yoga"
            >

            <div>
              <span>01</span>
              <h3>Yoga Basics</h3>
              <p>Start here →</p>
            </div>

          </a>

        </article>


        <article class="foundation-card">

          <a href="/breathwork">

            <img
              src="https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&w=1000&q=85"
              alt="Breathwork"
            >

            <div>
              <span>02</span>
              <h3>Breathwork</h3>
              <p>Learn to breathe →</p>
            </div>

          </a>

        </article>


        <article class="foundation-card">

          <a href="/meditation">

            <img
              src="https://images.unsplash.com/photo-1532798442725-41036acc7489?auto=format&fit=crop&w=1000&q=85"
              alt="Meditation"
            >

            <div>
              <span>03</span>
              <h3>Meditation</h3>
              <p>Find stillness →</p>
            </div>

          </a>

        </article>


        <article class="foundation-card">

          <a href="/sound">

            <img
              src="https://images.unsplash.com/photo-1529693662653-9d480530a697?auto=format&fit=crop&w=1000&q=85"
              alt="Sound"
            >

            <div>
              <span>04</span>
              <h3>Sound</h3>
              <p>Listen deeply →</p>
            </div>

          </a>

        </article>

      </div>

    </div>

  </section>


  <!-- EXPLORE -->

  <section class="explore section" id="explore">

    <div class="page-width">

      <div class="center-heading">

        <p class="section-kicker">
          FIND YOUR PRACTICE
        </p>

        <h2>Explore Yyogaa</h2>

      </div>


      <div class="explore-grid">

        <a href="/yoga">Beginner Yoga</a>
        <a href="/yoga">Flexibility</a>
        <a href="/yoga">Strength</a>

        <a href="/breathwork">Breathwork</a>
        <a href="/meditation">Meditation</a>
        <a href="/sound">Sound</a>

        <a href="/meditation">Sleep</a>
        <a href="/journal">Lifestyle</a>
        <a href="/journal">Philosophy</a>

      </div>

    </div>

  </section>


  <!-- CTA -->

  <section class="final-cta" id="start">

    <div>

      <p class="section-kicker">
        BEGIN
      </p>

      <h2>
        Your practice
        starts here.
      </h2>

      <p>
        Move with intention.
        Breathe with awareness.
        Return to yourself.
      </p>

      <a href="/contact" class="button button-gold">
        Join Yyogaa
      </a>

    </div>

  </section>

</main>

</BaseLayout>
