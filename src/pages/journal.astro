---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Journal — Yyogaa"
  description="The Yyogaa Journal — simple articles on yoga, breathwork, meditation, sound, recovery and mindful living."
>

<main>

  <section class="journal-page-hero">

    <div class="page-width">

      <p class="section-kicker">THE YYOGAA JOURNAL</p>

      <h1>
        Learn.
        <span>Practice.</span>
        Return.
      </h1>

      <p>
        Thoughtful guides on movement, breath, meditation,
        sound and mindful living.
      </p>

    </div>

  </section>


  <section class="section journal-feature">

    <div class="page-width">

      <div class="journal-feature-grid">

        <img
          src="https://images.unsplash.com/photo-1545205597-3d9d02c29597?auto=format&fit=crop&w=1400&q=85"
          alt="Yoga practice"
        >

        <div>

          <p class="section-kicker">FEATURED</p>

          <h2>
            Beginner Yoga:
            Where Do You Actually Start?
          </h2>

          <p>
            You do not need to be flexible, strong or experienced before
            beginning yoga. Start with the basics and let your practice grow.
          </p>

          <a href="/yoga" class="button button-gold-dark">
            Explore Yoga
          </a>

        </div>

      </div>

    </div>

  </section>


  <section class="section journal-list-section">

    <div class="page-width">

      <div class="journal-header">

        <div>
          <p class="section-kicker">LATEST</p>
          <h2>From the Journal</h2>
        </div>

      </div>


      <div class="journal-layout">

        <div class="journal-grid">

          <article class="story-card">

            <img
              src="https://images.unsplash.com/photo-1599901860904-17e6ed7083a0?auto=format&fit=crop&w=1000&q=85"
              alt="Yoga practice"
            >

            <p class="story-category">YOGA</p>

            <h3>
              How Often Should You Practice Yoga?
            </h3>

            <p class="story-copy">
              A realistic approach to building consistency without turning
              your practice into another obligation.
            </p>

            <a href="/yoga">Explore Yoga →</a>

          </article>


          <article class="story-card">

            <img
              src="https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&w=1000&q=85"
              alt="Breathwork"
            >

            <p class="story-category">BREATH</p>

            <h3>
              Breathwork for Complete Beginners
            </h3>

            <p class="story-copy">
              Start with awareness before exploring more structured breathing practices.
            </p>

            <a href="/breathwork">Explore Breath →</a>

          </article>


          <article class="story-card">

            <img
              src="https://images.unsplash.com/photo-1510894347712-4b17eeec7868?auto=format&fit=crop&w=1000&q=85"
              alt="Meditation"
            >

            <p class="story-category">MEDITATION</p>

            <h3>
              Why Your Mind Wanders During Meditation
            </h3>

            <p class="story-copy">
              A wandering mind does not mean you are bad at meditation.
            </p>

            <a href="/meditation">Explore Meditation →</a>

          </article>


          <article class="story-card">

            <img
              src="https://images.unsplash.com/photo-1529693662653-9d480530a697?auto=format&fit=crop&w=1000&q=85"
              alt="Sound practice"
            >

            <p class="story-category">SOUND</p>

            <h3>
              What Happens During a Sound Bath?
            </h3>

            <p class="story-copy">
              A simple introduction to immersive sound and mindful listening.
            </p>

            <a href="/sound">Explore Sound →</a>

          </article>


          <article class="story-card">

            <img
              src="https://images.unsplash.com/photo-1519710164239-da123dc03ef4?auto=format&fit=crop&w=1000&q=85"
              alt="Rest"
            >

            <p class="story-category">REST</p>

            <h3>
              Build a Better Evening Practice
            </h3>

            <p class="story-copy">
              A quieter way to transition from a busy day into rest.
            </p>

            <a href="/meditation">Explore Rest →</a>

          </article>


          <article class="story-card">

            <img
              src="https://images.unsplash.com/photo-1588286840104-8957b019727f?auto=format&fit=crop&w=1000&q=85"
              alt="Mobility"
            >

            <p class="story-category">MOVEMENT</p>

            <h3>
              Flexibility vs Mobility
            </h3>

            <p class="story-copy">
              They are related, but they are not exactly the same thing.
            </p>

            <a href="/yoga">Explore Movement →</a>

          </article>

        </div>


        <aside class="journal-sidebar">

          <div class="sidebar-section">

            <p class="section-kicker">MOST READ</p>

            <div class="most-read">

              <a href="/yoga">
                <span>1</span>
                <p>Yoga for Complete Beginners</p>
              </a>

              <a href="/yoga">
                <span>2</span>
                <p>What Type of Yoga Should You Try?</p>
              </a>

              <a href="/meditation">
                <span>3</span>
                <p>How Long Should You Meditate?</p>
              </a>

              <a href="/breathwork">
                <span>4</span>
                <p>Breathing Before Sleep</p>
              </a>

              <a href="/sound">
                <span>5</span>
                <p>What Is a Sound Bath?</p>
              </a>

            </div>

          </div>


          <div class="sidebar-section">

            <p class="section-kicker">TOPICS</p>

            <div class="sidebar-links">

              <a href="/yoga">Yoga</a>
              <a href="/breathwork">Breathwork</a>
              <a href="/meditation">Meditation</a>
              <a href="/sound">Sound</a>
              <a href="/meditation">Recovery</a>
              <a href="/meditation">Sleep</a>
              <a href="/about">Mindful Living</a>

            </div>

          </div>

        </aside>

      </div>

    </div>

  </section>


  <section class="final-cta">

    <div>

      <p class="section-kicker">KEEP LEARNING</p>

      <h2>
        Practice begins
        with curiosity.
      </h2>

      <p>
        Explore movement, breath, stillness and sound at your own pace.
      </p>

      <a href="/about" class="button button-gold">
        Explore Yyogaa
      </a>

    </div>

  </section>

</main>

</BaseLayout>
