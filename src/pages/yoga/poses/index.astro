---
// The pose library page (/yoga/poses): every published pose as a card, grouped by primary
// category in the order of src/content/taxonomy/pose-categories.yaml.
// Works without JavaScript: all poses are listed. With JavaScript, a search box and category
// filter buttons show/hide cards instantly and keep the choice in the URL
// (?q=…&category=…) so the view can be shared or reloaded (plan §8).
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SafetyNote from '../../../components/ui/SafetyNote.astro';
import PoseCard from '../../../components/library/PoseCard.astro';
import { getPublishedPoses } from '../../../lib/poses.js';
import '../../../styles/library.css';
// The raw text of the categories file, only to read the ORDER of its ids
// (getCollection does not keep the file's order). `?raw` is built into Vite.
import categoriesYaml from '../../../content/taxonomy/pose-categories.yaml?raw';

const poses = await getPublishedPoses();
const categoryOrder = [...categoriesYaml.matchAll(/^- id:\s*([a-z0-9-]+)/gm)].map((m) => m[1]);
const position = (id) => (categoryOrder.includes(id) ? categoryOrder.indexOf(id) : categoryOrder.length);
const categories = (await getCollection('poseCategories')).sort((a, b) => position(a.id) - position(b.id));
const levels = await getCollection('levels');
const levelName = (ref) => levels.find((l) => l.id === ref.id)?.data.name ?? '';

const groups = categories
  .map((category) => ({
    category,
    poses: poses.filter((p) => p.data.category.id === category.id),
  }))
  .filter((group) => group.poses.length > 0);

const count = poses.length;

// Filter buttons: the categories used as a primary category by at least one pose, in
// taxonomy order. A button matches a pose's primary category AND its `alsoIn` categories.
const filterCategories = groups.map(({ category }) => category);

// Text the search box matches against: English name, other names and Sanskrit names.
// Lowercased, accents removed (Śvānāsana → svanasana), punctuation turned into spaces.
// The page script uses the same rule on what the visitor types.
const toSearchText = (text) =>
  text
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/['’]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();

const searchText = (pose) =>
  toSearchText(
    [pose.data.name, ...pose.data.alsoKnownAs, pose.data.sanskrit?.iast, pose.data.sanskrit?.simple]
      .filter(Boolean)
      .join(' '),
  );

const poseCategories = (pose) => [pose.data.category.id, ...pose.data.alsoIn.map((ref) => ref.id)].join(' ');
---
<BaseLayout
  title="Yoga Pose Library — Yyogaa"
  description="Clear, gentle guides to yoga poses: how to practise each one, easier options, common mistakes and when to take care."
>

<main>

  <section class="pl-hero">
    <div class="page-width">

      <nav class="pl-breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/yoga">Yoga</a></li>
          <li><span aria-current="page">Poses</span></li>
        </ol>
      </nav>

      <p class="section-kicker">YYOGAA POSE LIBRARY</p>

      <h1>One pose <span>at a time.</span></h1>

      <p class="pl-summary">
        Plain-language guides to yoga poses: how to come into each shape,
        how to make it easier, and when to take care.
      </p>

    </div>
  </section>


  <div class="page-width pl-body pl-body-wide">

    <SafetyNote />

    <p class="pl-library-intro">
      This library is new and grows slowly, one carefully written pose at a time.
      Pose guides are not yet reviewed by a qualified yoga teacher, so please treat
      them as general guidance.
    </p>

    {/* Hidden until the script runs, so visitors without JavaScript never see controls
        that do nothing; they get the full list below. */}
    <form class="pl-filters" role="search" action="/yoga/poses" method="get" data-pose-filters hidden>

      <div class="pl-search">
        <label for="pose-search" class="pl-visually-hidden">Search yoga poses</label>
        <input
          type="search"
          id="pose-search"
          name="q"
          placeholder="Search yoga poses..."
          autocomplete="off"
          spellcheck="false"
        />
      </div>

      <div class="pl-chips" role="group" aria-label="Filter by category">
        <button type="button" class="pl-chip" data-category="" aria-pressed="true">All</button>
        {filterCategories.map((category) => (
          <button type="button" class="pl-chip" data-category={category.id} aria-pressed="false">
            {category.data.name.replace(/ poses$/, '')}
          </button>
        ))}
      </div>

    </form>

    <p class="pl-count" aria-live="polite" data-pose-count>{count} {count === 1 ? 'pose' : 'poses'}</p>

    {groups.map(({ category, poses }) => (
      <section class="pl-section pl-category" id={category.id} aria-labelledby={`${category.id}-heading`} data-pose-group>
        <h2 id={`${category.id}-heading`}>{category.data.name}</h2>
        <p class="pl-category-desc">{category.data.description}</p>
        <ul class="pl-card-grid" role="list">
          {poses.map((pose) => (
            <li data-pose-item data-search={searchText(pose)} data-categories={poseCategories(pose)}>
              <PoseCard pose={pose} levelName={levelName(pose.data.level)} />
            </li>
          ))}
        </ul>
      </section>
    ))}

    <div class="pl-empty" data-pose-empty hidden>
      <p>No poses found. Try another search or filter.</p>
      <button type="button" class="button pl-empty-clear" data-pose-clear>Clear</button>
    </div>

  </div>

</main>

</BaseLayout>

<script>
  // Instant search + category filter for the pose library. Plain JavaScript, no packages.
  const form = document.querySelector('[data-pose-filters]');

  if (form) {
    const input = form.querySelector('input[type="search"]');
    const chips = [...form.querySelectorAll('.pl-chip')];
    const items = [...document.querySelectorAll('[data-pose-item]')];
    const groups = [...document.querySelectorAll('[data-pose-group]')];
    const countEl = document.querySelector('[data-pose-count]');
    const emptyEl = document.querySelector('[data-pose-empty]');
    const clearBtn = document.querySelector('[data-pose-clear]');
    const knownCategories = chips.map((chip) => chip.dataset.category).filter(Boolean);

    // Must match toSearchText() in the page frontmatter.
    const toSearchText = (text) =>
      text
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .replace(/['’]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, ' ')
        .trim();

    let category = '';

    const setCategory = (id) => {
      category = knownCategories.includes(id) ? id : '';
      for (const chip of chips) {
        chip.setAttribute('aria-pressed', String(chip.dataset.category === category));
      }
    };

    const update = () => {
      // Every word typed must match the START of a word in the pose's names, so "down dog"
      // finds Downward-Facing Dog, but "war" finds Warrior II and not "Forward Fold".
      const words = toSearchText(input.value).split(' ').filter(Boolean);
      let shown = 0;

      for (const item of items) {
        const inCategory = !category || item.dataset.categories.split(' ').includes(category);
        const names = ` ${item.dataset.search}`;
        const matchesText = words.every((word) => names.includes(` ${word}`));
        const visible = inCategory && matchesText;
        item.hidden = !visible;
        if (visible) shown += 1;
      }

      for (const group of groups) {
        group.hidden = !group.querySelector('[data-pose-item]:not([hidden])');
      }

      countEl.textContent = `${shown} ${shown === 1 ? 'pose' : 'poses'}`;
      emptyEl.hidden = shown > 0;

      // Keep the choice in the address so it can be shared or reloaded.
      const params = new URLSearchParams(location.search);
      const q = input.value.trim();
      q ? params.set('q', q) : params.delete('q');
      category ? params.set('category', category) : params.delete('category');
      const query = params.toString();
      history.replaceState(null, '', `${location.pathname}${query ? `?${query}` : ''}${location.hash}`);
    };

    // Start from the address, e.g. /yoga/poses?category=backbend&q=cobra. Unknown values are ignored.
    const params = new URLSearchParams(location.search);
    input.value = params.get('q') ?? '';
    setCategory(params.get('category') ?? '');

    input.addEventListener('input', update);
    form.addEventListener('submit', (event) => event.preventDefault());

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        setCategory(chip.dataset.category);
        update();
      });
    }

    clearBtn.addEventListener('click', () => {
      input.value = '';
      setCategory('');
      update();
      input.focus();
    });

    form.hidden = false;
    update();
  }
</script>
