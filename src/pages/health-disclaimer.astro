---
// Health Disclaimer (/health-disclaimer). The plan (§11.3) requires this page to exist
// before any pose goes public. Linked from every pose page and from the library page.
// DRAFT wording by the YYOGAA team: have it checked by a lawyer before monetisation or accounts.
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/library.css';
---
<BaseLayout
  title="Health Disclaimer — Yyogaa"
  description="Yyogaa shares general wellness information, not medical advice. Please read this before you practise any pose, breath or meditation."
>

<main>

  <section class="pl-hero">
    <div class="page-width">

      <p class="section-kicker">YOUR WELLBEING FIRST</p>

      <h1>Health <span>disclaimer.</span></h1>

      <p class="pl-summary">
        Please read this before you practise anything you find on Yyogaa.
      </p>

    </div>
  </section>


  <div class="page-width pl-body pl-prose">

    <section class="pl-section" aria-labelledby="general-heading">
      <h2 id="general-heading">General information, not medical advice</h2>
      <p>
        Yyogaa shares general wellness information about yoga, breathwork, meditation
        and sound. It is not medical advice, and it cannot replace advice, diagnosis
        or treatment from a doctor or another qualified health professional.
      </p>
    </section>

    <section class="pl-section" aria-labelledby="check-heading">
      <h2 id="check-heading">Check first if you need to</h2>
      <p>
        If you are pregnant, injured, recovering from surgery or illness, or living
        with a medical condition, please check with a qualified health professional
        before you begin any new practice.
      </p>
    </section>

    <section class="pl-section" aria-labelledby="listen-heading">
      <h2 id="listen-heading">Listen to your body</h2>
      <p>
        Move slowly and never force a position. Stop straight away if you feel pain,
        dizziness, faintness, numbness, tingling or shortness of breath, and seek
        medical help if it does not pass.
      </p>
    </section>

    <section class="pl-section" aria-labelledby="guides-heading">
      <h2 id="guides-heading">About our pose guides</h2>
      <p>
        Our pose guides are written in plain language by the Yyogaa team. We are
        working towards having every guide reviewed by a qualified yoga teacher.
        Each guide shows its review status; until it says it has been reviewed,
        please treat it as general guidance only. Written instructions cannot see
        you or adjust to you. A qualified teacher in person can.
      </p>
    </section>

    <section class="pl-section" aria-labelledby="choice-heading">
      <h2 id="choice-heading">Your choice, your pace</h2>
      <p>
        You decide whether and how to practise. Please practise within your own
        limits and at your own risk.
      </p>
    </section>

    <section class="pl-section" aria-labelledby="emergency-heading">
      <h2 id="emergency-heading">In an emergency</h2>
      <p>
        If you think you may be having a medical emergency, contact your local
        emergency services straight away.
      </p>
    </section>

    <p class="pl-byline">Last updated 30 September 2026.</p>

  </div>

</main>

</BaseLayout>
